#!/usr/bin/env bash
# Displays the record type and destination of subdomains of a given domain
display_info () {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v s="$2" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]; then
    display_info "$1" "$2"
else
    for s in www lb-01 web-01 web-02; do
        display_info "$1" "$s"
    done
fi
